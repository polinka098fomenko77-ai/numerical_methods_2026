print(f"інтегрується f(x) = 50 + 20*sin(πx/12) + 5*exp(-0.2*(x-12)²)")
print(f"відрізок [{a}, {b}]")
print(f"точне значення: {exact_value:.10f}")
print(f"n_min для ε={eps}: {n_min}")
print(f"похибка сімпсон(n1={n1}):  {error_n1:.4e}")
print(f"похибка рунге-ромберг:     {error_runge:.4e}")
print(f"похибка ейткен:            {error_aitken:.4e}")
print(f"порядок точності (ейткен): {p_estimated:.4f} (теоретичний: 4.0)")
print(f"адаптивний ε=1e-6: похибка={adaptive_errors[-1]:.4e}, викликів={adaptive_calls[-1]}")
