import math  # підключаємо модуль для математичних функцій (exp, sin, cos, log2)
import matplotlib.pyplot as plt # підключаємо модуль pyplot для візуалізації результатів у вигляді графіків

# визначення функцій

def M(t):  # функція вологості ґрунту M(t)
    return 50 * math.exp(-0.1 * t) + 5 * math.sin(t)  # повертаємо значення функції в точці t

def dM_exact(t):  # аналітична (точна) похідна
    return -5 * math.exp(-0.1 * t) + 5 * math.cos(t)  # повертаємо точне значення похідної в точці t

def central(t, h):  # апроксимація похідної центральною різницею 2-й порядок точності
    return (M(t + h) - M(t - h)) / (2 * h)

# вхідні дані

t0 = 1  # точка, в якій обчислюємо похідну


# аналітична похідна та точне значення


exact = dM_exact(t0)  # обчислюємо точне значення M′(1)

print("=" * 0)  # розділювач для читабельності виводу
print("аналітична похідна")  # заголовок блоку
print("=" * 0)  # розділювач
print(f"M(t)   = 50·e^(-0.1t) + 5·sin(t)")  # друкуємо формулу функції
print(f"M′(t)  = -5·e^(-0.1t) + 5·cos(t)")  # друкуємо формулу похідної
print(f"M′(1)  = {exact:.8f}  ← точне значення")  # друкуємо точне значення з 8 знаками
print(f"M(1)   = {M(t0):.6f}")  # друкуємо значення самої функції в точці t0=1


# залежність похибки від кроку h
print("\n" + "=" * 0)  # відступ + розділювач
print(" центральна різниця, залежність похибки від h")  # заголовок
print("=" * 0)  # розділювач
print(f"{'h':>12}  {'D(h)':>14}  {'похибка':>14}  {'примітка'}")  # шапка таблиці з вирівнюванням
print("-" * 0)  # горизонтальна лінія під шапкою

steps = [10**(-i) for i in range(13)]  # список кроків [1, 0.1, 0.01, ..., 1e-12]

errors = []  # порожній список сюди будемо складати похибки для кожного h
for h in steps:  # проходимо по кожному кроку зі списку
    d = central(t0, h)   # обчислюємо апроксимацію D(h) при даному кроці
    e = abs(d - exact)   # абсолютна похибка: |D(h) - M′(1)|
    errors.append(e)     # додаємо похибку до списку

best_idx = errors.index(min(e for e in errors if e > 0))  # індекс мінімальної ненульової похибки
h_opt    = steps[best_idx]  # оптимальний крок h* — при ньому найменша похибка

for i, (h, e) in enumerate(zip(steps, errors)):  # проходимо одночасно по кроках і похибках
    d    = central(t0, h)  # перераховуємо D(h) для виводу в таблицю
    note = "  ← оптимум h*" if i == best_idx else ""  # позначка оптимального рядка
    print(f"{h:>12.2e}  {d:>14.8f}  {e:>14.3e}{note}")  # друкуємо рядок таблиці

print(f"\nОптимальний крок: h* = {h_opt:.2e}")       # виводимо знайдений h*
print(f"Похибка при h*:   ε  = {errors[best_idx]:.3e}")  # виводимо мінімальну похибку


#фіксуємо h = h*


print("\n" + "=" * 0)  # відступ + розділювач
print("фіксуємо h = h*")  # заголовок
print("=" * 0)  # розділювач

h = h_opt  # приймаємо оптимальний крок як робочий
print(f"h = {h:.2e}")  # виводимо прийняте значення кроку


#  обчислення при h та h/2 ta оцінка похибки


print("\n" + "=" * 0)  # відступ + розділювач
print(" D(h) та D(h/2), похибки")  # заголовок
print("=" * 0)  # розділювач

D1   = central(t0, h)      # D(h)   — апроксимація при більшому кроці h
D2   = central(t0, h / 2)  # D(h/2) — апроксимація при вдвічі меншому кроці
err1 = abs(D1 - exact)     # похибка при h   |D(h)   - M′(1)|
err2 = abs(D2 - exact)     # похибка при h/2 |D(h/2) - M′(1)| ta очікуємо меншу

print(f"D(h)    = {D1:.10f}   похибка = {err1:.3e}")  # виводимо D(h) і його похибку
print(f"D(h/2)  = {D2:.10f}   похибка = {err2:.3e}")  # виводимо D(h/2) і його похибку
print(f"Зменшення похибки: {err1/err2:.1f}× при зменшенні кроку вдвічі")  # показуємо відношення похибок

#метод Рунге–Ромберга


print("\n" + "=" * 0)  # відступ + розділювач
print("метод Рунге–Ромберга")  # заголовок
print("=" * 0)  # розділювач
print("Формула: D_RR = D(h/2) + [D(h/2) - D(h)] / (2^p - 1)")  # виводимо формулу методу

p_rr   = 2                    # порядок точності вихідної формули (центральна різниця — p=2)
k      = 2**p_rr - 1          # знаменник формули Рунге-Ромберга 2^2 - 1 = 3
D_RR   = D2 + (D2 - D1) / k  # уточнене значення: виключаємо головний член похибки
err_RR = abs(D_RR - exact)    # похибка після уточнення — має бути менша ніж err2

print(f"p   = {p_rr}  →  2^p - 1 = {k}")              # виводимо параметри формули
print(f"D_RR  = {D_RR:.10f}")                           # уточнене значення
print(f"Точне = {exact:.10f}")                           # точне для порівняння
print(f"Похибка після Рунге-Ромберга: ε_RR = {err_RR:.3e}")  # похибка після методу
if err_RR > 0 and err2 > 0:  # перевірка щоб не ділити на нуль
    print(f"Покращення: у {err2/err_RR:.1f}× відносно D(h/2)")  # скільки разів покращилась точність


# метод Ейткена


print("\n" + "=" * 0)  # відступ + розділювач
print("метод Ейткена")  # заголовок
print("=" * 0)  # розділювач
print("Формула: D* = D(h) - [D(h/2)-D(h)]² / [D(h/4) - 2·D(h/2) + D(h)]")  # формула Ейткена

D3 = central(t0, h / 4)  # третє значення апроксимації при кроці h/4

num   = (D2 - D1) ** 2     # чисельник формули Ейткена
den   = D3 - 2 * D2 + D1  # знаменник
D_Ait = D1 - num / den     # уточнене значення за Ейткеном
err_A = abs(D_Ait - exact) # похибка після уточнення Ейткеном

p_est = math.log2(abs(D1 - D2) / abs(D2 - D3))  # оцінка порядку

print(f"D(h)    = {D1:.10f}")   # виводимо перше значення
print(f"D(h/2)  = {D2:.10f}")   # виводимо друге значення
print(f"D(h/4)  = {D3:.10f}")   # виводимо третє значення
print(f"D_Ait   = {D_Ait:.10f}")  # уточнене значення за Ейткеном
print(f"Точне   = {exact:.10f}")  # точне для порівняння
print(f"Похибка після Ейткена:  ε_A = {err_A:.3e}")              # похибка методу Ейткена
print(f"Оцінений порядок точності: p ≈ {p_est:.4f}  (теоретично p=2)")  # оцінений порядок

# всі методи разом


print("\n" + "=" * 0)  # відступ + розділювач
print("порівняння всіх методів")  # заголовок
print("=" * 0)  # розділювач
print(f"{'Метод':<30}  {'Значення':>14}  {'Похибка':>12}  {'Порядок'}")  # шапка таблиці
print("-" * 0)  # горизонтальна лінія

results_list = [  # список кортежів: (назва методу, значення, похибка, порядок)
    ("Центральна різниця D(h)",   D1,    err1,          "O(h²)"),  # при кроці h
    ("Центральна різниця D(h/2)", D2,    err2,          "O(h²)"),  # при кроці h/2
    ("Центральна різниця D(h/4)", D3,    abs(D3-exact), "O(h²)"),  # при кроці h/4
    ("Рунге–Ромберг",             D_RR,  err_RR,        "O(h⁴)"),  # уточнення Рунге-Ромберга
    ("Ейткен",                    D_Ait, err_A,         "O(h⁴)"),  # уточнення Ейткена
]
for name, val, err, order in results_list + [("Точне значення M′(1)", exact, 0.0, "—")]:  # розпаковуємо кожен кортеж і друкуємо рядок
    print(f"{name:<30}  {val:>14.8f}  {err:>12.3e}  {order}")  # форматований рядок таблиці


# Побудова графіків

plt.figure(figsize=(12, 6)) # створюємо вікно для графіків

# 1. Графік залежності похибки від кроку h (логарифмічна шкала)
plt.subplot(1, 2, 1) # перша область малювання
plt.loglog(steps, errors, 'bo-', label='Похибка central difference') # малюємо в логарифмічних осях
plt.axvline(h_opt, color='r', linestyle='--', label=f'h* = {h_opt:.2e}') # лінія оптимального кроку
plt.title('Залежність похибки від кроку h') # заголовок
plt.xlabel('Крок h') # вісь X
plt.ylabel('Абсолютна похибка') # вісь Y
plt.grid(True, which="both", ls="-", alpha=0.5) # сітка
plt.legend() # легенда

# 2. Порівняння похибок різних методів
plt.subplot(1, 2, 2) # друга область малювання
methods = [r'$D(h)$', r'$D(h/2)$', r'$D_{RR}$', r'$D_{Ait}$'] # назви методів (з використанням LaTeX)
error_vals = [err1, err2, err_RR, err_A] # значення похибок для порівняння
plt.bar(methods, error_vals, color=['blue', 'cyan', 'green', 'orange']) # стовпчикова діаграма
plt.yscale('log') # логарифмічна шкала для вісі Y
plt.title('Порівняння похибок методів') # заголовок
plt.ylabel('Похибка (log scale)') # вісь Y
plt.grid(axis='y', linestyle='--', alpha=0.7) # сітка по Y

plt.tight_layout() # автоматичне вирівнювання відступів
plt.show() # відображення графіків


print("\n" + "=" * 0)  # відступ + розділювач
print("висновок — оптимальний режим поливу")  # заголовок
print("=" * 0)  # розділювач
print(f"M′(1) ≈ {exact:.6f}")  # виводимо точне значення похідної
if exact < 0:  # якщо похідна від'ємна — вологість зменшується
    print("Похідна від'ємна → вологість спадає → полив варто вмикати")  # рекомендація
else:  # якщо похідна додатна — вологість зростає або стабільна
    print("Похідна додатна → вологість зростає → полив поки не потрібен")  # рекомендація
print(f"\nШвидкість зміни вологості: {abs(exact):.4f} од/с")              # модуль похідної
print(f"Оптимальний крок диференціювання: h* = {h_opt:.2e}")               # знайдений h*
print(f"Найкраща досягнута точність (Ейткен): ε = {err_A:.3e}")            # найменша похибка
