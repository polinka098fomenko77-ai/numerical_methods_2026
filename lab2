import numpy as np
import matplotlib.pyplot as plt
import csv

# функція для зчитування вхідних даних із зовнішнього csv файлу
def read_data(filename):
    # створюємо порожній список для збереження кількості об'єктів
    objects = []
    # створюємо порожній список для збереження значень fps
    fps = []
    # відкриваємо файл за назвою у режимі читання 'r'
    with open(filename, 'r') as file:
        # ініціалізуємо об'єкт DictReader для доступу до даних за назвами колонок
        reader = csv.DictReader(file)
        # запускаємо цикл для перебору кожного рядка у файлі
        for row in reader:
            # перетворюємо рядок зі стовпця 'Objects' у число та додаємо в масив
            objects.append(float(row['Objects']))
            # перетворюємо рядок зі стовпця 'FPS' у число та додаємо в масив
            fps.append(float(row['FPS']))
    # повертаємо кортеж із двох numpy масивів для зручної математичної обробки
    return np.array(objects), np.array(fps)

# функція для розрахунку таблиці розділених різниць для многочлена ньютона
def divided_differences(x, y):
    # визначаємо кількість точок даних n
    n = len(y)
    # створюємо квадратну матрицю розміром n на n заповнену нулями
    coef = np.zeros([n, n])
    # заповнюємо перший стовпець матриці значеннями функції y (це нульові розділені різниці)
    coef[:,0] = y
    # зовнішній цикл j відповідає за порядок розділеної різниці (від 1 до n-1)
    for j in range(1, n):
        # внутрішній цикл i розраховує елементи для поточного порядку j
        for i in range(n - j):
            # обчислюємо розділену різницю за рекурсивною формулою через попередні значення
            # чисельник - це різниця значень з попереднього стовпця, знаменник - різниця вузлів x
            coef[i][j] = (coef[i+1][j-1] - coef[i][j-1]) / (x[i+j] - x[i])
    # для побудови многочлена нам потрібен лише верхній рядок отриманої таблиці
    return coef[0, :]

# функція для знаходження значення інтерполяційного многочлена у довільній точці
def newton_interpolation(x_nodes, coef, x_target):
    # визначаємо ступінь многочлена, що дорівнює кількості коефіцієнтів мінус один
    n = len(coef) - 1
    # починаємо обчислення з останнього коефіцієнта для реалізації схеми горнера
    p = coef[n]
    # рухаємося у зворотному порядку від n-1 до 0 для ефективного множення
    for k in range(1, n + 1):
        # виконуємо ітераційне множення на різницю (x - x_i) та додаємо наступний коефіцієнт
        # такий підхід мінімізує кількість арифметичних операцій у порівнянні з прямою формулою
        p = coef[n - k] + (x_target - x_nodes[n - k]) * p
    # повертаємо фінальне інтерпольоване значення функції у заданій точці x_target
    return p

# підготовчий етап: створення тестового csv файлу згідно з таблицею варіанту 5
with open('data_v5.csv', 'w', newline='') as f:
    # створюємо об'єкт для запису у файл
    writer = csv.writer(f)
    # записуємо заголовки стовпців як вказано в лабі
    writer.writerow(['Objects', 'FPS'])
    # записуємо експериментальні пари значень: об'єкти та відповідний їм fps
    writer.writerows([[100, 120], [200, 110], [400, 90], [800, 65], [1600, 40]])


#  зчитуємо підготовлені дані з файлу за допомогою  функції
x_data, y_data = read_data('data_v5.csv')
#  розраховуємо набір коефіцієнтів розділених різниць для моделі
coefficients = divided_differences(x_data, y_data)

# прогнозуємо значення fps для 1000 ігрових об'єктів
target_obj = 1000
predicted_fps = newton_interpolation(x_data, coefficients, target_obj)
# виводимо результат прогнозу у консоль з округленням до двох знаків
print(f"прогноз fps для {target_obj} об'єктів: {predicted_fps:.2f}")

#  визначаємо межу стабільності (fps не нижче 60)
# створюємо масив із 500 точок між мінімальним та максимальним значенням для точності графіка
x_range = np.linspace(100, 1600, 500)
# обчислюємо значення многочлена для кожної точки згенерованого діапазону
y_interp = [newton_interpolation(x_data, coefficients, val) for val in x_range]

# шукаємо останнє значення x, при якому функція видає більше або рівно 60 кадрів
limit_obj = 0
for i in range(len(x_range)):
    # якщо значення моделі відповідає умові комфортної гри
    if y_interp[i] >= 60:
        # фіксуємо це значення як потенційний ліміт об'єктів
        limit_obj = x_range[i]
# виводимо знайдене обмеження для ігрового рушія
print(f"максимальна кількість об'єктів для стабільних 60 fps: ~{int(limit_obj)}")

# блок візуалізації результатів (побудова графіка)
# відображаємо реальні точки з таблиці червоними маркерами
plt.scatter(x_data, y_data, color='red', label='експериментальні вузли (таблиця)')
# будуємо синю лінію інтерполяційного многочлена за обчисленими точками
plt.plot(x_range, y_interp, color='blue', label='інтерполяційна модель ньютона')
# малюємо горизонтальну лінію на рівні 60 fps для наочності порогу
plt.axhline(y=60, color='green', linestyle='--', label='поріг комфортного fps (60)')
# підписуємо горизонтальну вісь як кількість об'єктів у сцені
plt.xlabel("кількість об'єктів у сцені (Objects)")
# підписуємо вертикальну вісь як продуктивність у кадрах на секунду
plt.ylabel("продуктивність (FPS)")
# додаємо заголовок до графічного вікна
plt.title("аналіз продуктивності ігрового рушія через інтерполяцію")
# активуємо відображення сітки для кращого зчитування координат
plt.grid(True, which='both', linestyle=':', alpha=0.5)
# додаємо легенду, щоб розрізняти лінії та маркери
plt.legend()
# викликаємо команду відображення вікна з готовим графіком
plt.show()


print(f"\n розпочинаємо дослідницька частину")

# створюємо графічне вікно для результатів дослідження
plt.figure(figsize=(14, 6))

# дослідження впливу кількості вузлів
# для цього фіксуємо інтервал [100, 1600] та змінюємо кількість точок n
plt.subplot(1, 2, 1)
x_fine = np.linspace(100, 1600, 500)
for n_nodes in [3, 5, 8]:
    # генеруємо вузли з рівномірним кроком
    x_test = np.linspace(100, 1600, n_nodes)
    # моделюємо значення fps на основі експоненти (імітація поведінки рушія)
    y_test = 140 * np.exp(-x_test / 1000)
    # розраховуємо коефіцієнти для кожної кількості вузлів
    c = divided_differences(x_test, y_test)
    # будуємо криву для поточного набору вузлів
    y_plot = [newton_interpolation(x_test, c, xi) for xi in x_fine]
    plt.plot(x_fine, y_plot, label=f'вузлів: {n_nodes}')

plt.title("вплив кількості вузлів на точність")
plt.xlabel("кількість об'єктів")
plt.ylabel("fps")
plt.legend()
plt.grid(True)

#аналіз ефекту рунге
# ефект рунге виникає, коли ми беремо забагато вузлів на рівномірній сітці
# це призводить до неконтрольованих осциляцій (коливань) на краях інтервалу
plt.subplot(1, 2, 2)
n_runge = 12 # беремо велику кількість точок, щоб спровокувати ефект
x_runge = np.linspace(100, 1600, n_runge)
# функція, яка демонструє похибки на краях
y_runge = 1 / (1 + (x_runge - 850)**2 / 100000)
c_runge = divided_differences(x_runge, y_runge)
y_plot_runge = [newton_interpolation(x_runge, c_runge, xi) for xi in x_fine]

# малюємо криву з осциляціями
plt.plot(x_fine, y_plot_runge, 'r-', label='многочлен (ефект рунге)')
# позначаємо вузли, де вимірювалися значення
plt.scatter(x_runge, y_runge, color='black', label='вузли інтерполяції')
plt.title("аналіз ефекту рунге (осциляції на краях)")
plt.xlabel("кількість об'єктів")
plt.ylabel("значення функції")
plt.legend()
plt.grid(True)

# відображаємо всі графіки дослідницької частини
plt.tight_layout()
plt.show()

print("дослідження завершено: помічено, що збільшення вузлів підвищує точність у центрі,")
print("але провокує ефект рунге (коливання) на краях інтервалу при високих порядках многочлена.")
